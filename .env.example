# ── GitHub ────────────────────────────────────────────────────────────────
# PAT (classic) with `repo` scope. Client env swaps this for a GitHub App (see MIGRATION.md).
GITHUB_TOKEN=ghp_your_token_here

# Comma-separated list of repos to scan (owner/name)
REPOS=your-username/test-repo-1,your-username/test-repo-2

# ── Azure OpenAI (Foundry) ────────────────────────────────────────────────
# FOUNDRY_ENDPOINT — paste any endpoint URL from the Azure portal (the project
#   endpoint https://<resource>.services.ai.azure.com/api/projects/<name> is fine;
#   the code derives the resource host and calls /openai/v1/).
#   Alternatively set FOUNDRY_RESOURCE=<resource-name> instead.
# FOUNDRY_API_KEY — resource API key. Leave blank for Entra ID: managed identity
#   in Azure, `az login` locally (needs azure-identity; role: Cognitive Services
#   User / OpenAI User on the resource). Key and Entra ID are mutually exclusive.
# FOUNDRY_TOKEN_SCOPE — override only for sovereign clouds; default is
#   https://ai.azure.com/.default
FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_API_KEY=

# Model routing: these are Azure DEPLOYMENT names (as created in the Foundry
# portal), not catalogue model IDs. Cheap deployment for routine verdicts,
# stronger one for major bumps / grouped PRs / escalation. With one deployment,
# point both at it — escalation then simply no-ops.
LLM_MODEL_DEFAULT=gpt-5.6-sol
LLM_MODEL_ESCALATION=gpt-5.6-sol

# Cost guard: hard cap on LLM calls per run (circuit breaker)
LLM_MAX_CALLS_PER_RUN=100

# Tool-use loop cap per PR
LLM_MAX_TOOL_ITERATIONS=5

# ── Storage (local JSON now → Azure Table Storage at migration) ───────────
AUDIT_LOG_PATH=data/audit_log.jsonl
VERDICT_CACHE_PATH=data/verdict_cache.json

# ── Report ────────────────────────────────────────────────────────────────
# Local: digest rendered to file. Client env: Teams incoming webhook URL.
DIGEST_OUTPUT_PATH=data/digest.md
TEAMS_WEBHOOK_URL=

# ── GitHub ────────────────────────────────────────────────────────────────
# PAT (classic) with `repo` scope. Client env swaps this for a GitHub App (see MIGRATION.md).
GITHUB_TOKEN=ghp_your_token_here

# Comma-separated list of repos to scan (owner/name)
REPOS=your-username/test-repo-1,your-username/test-repo-2

# ── LLM provider ──────────────────────────────────────────────────────────
# anthropic (local build) | foundry (Claude in Microsoft Foundry)
LLM_PROVIDER=anthropic

# Only used when LLM_PROVIDER=foundry: paste any portal endpoint (project endpoint is
# fine, the resource host is derived); blank key in client env -> Entra ID
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Model routing: Haiku for routine verdicts, Sonnet for major bumps / grouped PRs / escalation
LLM_MODEL_DEFAULT=claude-haiku-4-5-20251001
LLM_MODEL_ESCALATION=claude-sonnet-5

# Cost guard: hard cap on Claude calls per run (circuit breaker)
LLM_MAX_CALLS_PER_RUN=100

# Tool-use loop cap per PR
LLM_MAX_TOOL_ITERATIONS=5

# ── Storage (local JSON now → Azure Table Storage at migration) ───────────
AUDIT_LOG_PATH=data/audit_log.jsonl
VERDICT_CACHE_PATH=data/verdict_cache.json

# ── Report ────────────────────────────────────────────────────────────────
# Local: digest rendered to file. Client env: Teams incoming webhook URL.
DIGEST_OUTPUT_PATH=data/digest.md
TEAMS_WEBHOOK_URL=

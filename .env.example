# ── GitHub ────────────────────────────────────────────────────────────────
# PAT (classic) with `repo` scope. Client env swaps this for a GitHub App (see MIGRATION.md).
GITHUB_TOKEN=ghp_your_token_here

# Comma-separated list of repos to scan (owner/name)
REPOS=your-username/test-repo-1,your-username/test-repo-2

# GitHub Enterprise only: server root, e.g. https://ghe.example.com
# (the /api/graphql and /api/v3 paths are derived). Unset means github.com.
# Used by the collector AND the pre-flight check — set it once, here.
# GITHUB_API_URL=

# GHE only: release notes are fetched from PUBLIC github.com, where the GHE token
# above does not work. Set a github.com token to avoid the 60 req/hour
# unauthenticated limit. Ignored when GITHUB_API_URL is unset.
# PUBLIC_GITHUB_TOKEN=

# Verify the token and repo access before a run:
#   python ghe_token_test.py

# ── Azure OpenAI (Foundry) ────────────────────────────────────────────────
# Paste any endpoint URL from the Azure portal — the project endpoint
# https://<resource>.services.ai.azure.com/api/projects/<name> is fine, the code
# derives the resource host from it and calls /openai/v1.
FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# FOUNDRY_RESOURCE=your-resource        # alternative to FOUNDRY_ENDPOINT

# Resource API key for local testing. Leave BLANK to authenticate with Entra ID:
# managed identity in Azure, `az login` locally (requires azure-identity).
# The identity needs the data-plane role "Cognitive Services OpenAI User" on the
# resource — subscription Owner is control-plane only and does NOT grant it.
FOUNDRY_API_KEY=
# FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default   # override for sovereign clouds

# Model routing: Azure DEPLOYMENT names (as created in the Foundry portal), not
# catalogue model IDs. Cheap deployment for routine verdicts, stronger one for
# major bumps / grouped PRs / escalation. With one deployment, point both at it —
# escalation then simply no-ops.
LLM_MODEL_DEFAULT=your-gpt-deployment
LLM_MODEL_ESCALATION=your-gpt-deployment

# Cost guard: hard cap on LLM calls per run (circuit breaker)
LLM_MAX_CALLS_PER_RUN=100

# Tool-use loop cap per PR
LLM_MAX_TOOL_ITERATIONS=5

# Verify endpoint, auth and deployment names before a run:
#   python scripts/smoke_test.py

# ── Storage (local JSON now → Azure Table Storage at migration) ───────────
AUDIT_LOG_PATH=data/audit_log.jsonl
VERDICT_CACHE_PATH=data/verdict_cache.json

# ── Report ────────────────────────────────────────────────────────────────
# Local: digest rendered to file. Client env: Teams incoming webhook URL.
DIGEST_OUTPUT_PATH=data/digest.md
TEAMS_WEBHOOK_URL=
